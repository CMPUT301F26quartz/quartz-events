rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  function isAdmin() {
    return request.auth != null
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
  }

    match /users/{userId} {

      // Users can read their own profile
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      // Users can create their own entrant or campsite owner profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ["entrant", "owner"]
                    && request.resource.data.keys().hasAll(
                      ["uid", "name", "email", "role", "username", "phoneNumber"]
                    )
                    && request.resource.data.keys().hasOnly(
                      ["uid", "name", "email", "role", "username", "phoneNumber"]
                    )
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.username is string
                    && request.resource.data.phoneNumber is string;

      // Prevent changes to profiles for now
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /campsites/{campsiteId}{
    
    allow read: if request.auth != null;

    allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

    allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

    
    }
    // Entrants can read their own reservations
    match /Reservations/{reservationId} {
    allow read: if request.auth != null
    && resource.data.entrantId == request.auth.uid;
    }

    // Messaging permissions
    match /Reservations/{reservationId} {
      // Campsite owners can read reservations for their own campsites.
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/campsites/$(resource.data.campsiteId)).data.ownerId == request.auth.uid;
    }

    // A private query context lets Firestore verify the campsite used by a list query.
    match /users/{uid}/messagingContext/campsite {
      allow get: if request.auth != null && uid == request.auth.uid;
      allow create, update: if request.auth != null && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['siteId'])
        && request.resource.data.siteId is string
        && get(/databases/$(database)/documents/campsites/$(request.resource.data.siteId)).data.ownerId == uid;
    }
    match /Lotteries/{lotteryId} {
      function matchesOwnedSite() {
        let uid = request.auth.uid;
        let id = get(/databases/$(database)/documents/users/$(uid)/messagingContext/campsite).data.siteId;
        let site = /databases/$(database)/documents/campsites/$(id);
        let record = get(site).data;
        return record.ownerId == uid && (
          resource.data.campsites.hasAny([site, id, {'id': id}, record.get('id', '') == id ? record : {'id': id}])
          || id in resource.data.get('messagingCampsiteIds', []));
      }
      allow read: if request.auth != null && matchesOwnedSite();
    }

    match /messages/{id} {
      function senderIsAuthenticated(d) {
        return request.auth != null && d.senderId == request.auth.uid &&
          d.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('name', request.auth.uid) &&
          d.receiverId is string && d.receiverId.size() > 0 &&
          d.message is string && d.message.size() > 0 && d.message.size() <= 2000 &&
          d.title is string && d.sentAt == request.time;
      }
      function siteMatches(value, id) {
        return value == id || value == /databases/$(database)/documents/campsites/$(id) ||
          (value is map && value.get('id', '') == id);
      }
      function entrantMatches(value, uid) {
        return value == uid || value == /databases/$(database)/documents/users/$(uid) ||
          (value is map && value.get('uid', '') == uid);
      }
      function isWaitlistNotice(d) {
        let draw = get(/databases/$(database)/documents/Lotteries/$(d.lotteryId)).data;
        return d.keys().hasOnly(['type','kind','senderId','senderName','receiverId','broadcastId',
          'title','campsiteId','lotteryId','siteIndex','entrantIndex','message','sentAt']) &&
          d.kind == 'waitlist_notice' && d.broadcastId is string &&
          get(/databases/$(database)/documents/campsites/$(d.campsiteId)).data.ownerId == request.auth.uid &&
          d.siteIndex is int && d.siteIndex >= 0 && d.siteIndex < draw.campsites.size() &&
          d.entrantIndex is int && d.entrantIndex >= 0 && d.entrantIndex < draw.entrants.size() &&
          siteMatches(draw.campsites[d.siteIndex], d.campsiteId) &&
          entrantMatches(draw.entrants[d.entrantIndex], d.receiverId);
      }
      function isReservationMessage(d) {
        let booking = get(/databases/$(database)/documents/Reservations/$(d.reservationId)).data;
        let owner = get(/databases/$(database)/documents/campsites/$(booking.campsiteId)).data.ownerId;
        return d.keys().hasOnly(['type','senderId','senderName','receiverId','reservationId','title','message','sentAt']) &&
          d.senderId != d.receiverId && ((d.senderId == owner && d.receiverId == booking.entrantId) ||
            (d.senderId == booking.entrantId && d.receiverId == owner));
      }
      allow read: if request.auth != null && (
        resource.data.get('senderId', '') == request.auth.uid || resource.data.get('receiverId', '') == request.auth.uid);
      allow create: if senderIsAuthenticated(request.resource.data) &&
        ((request.resource.data.type == 'notification' && isWaitlistNotice(request.resource.data)) ||
         (request.resource.data.type == 'direct' && isReservationMessage(request.resource.data)));
    }
    match /users/{uid}/messageRequests/{requestId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['target','body','count']) &&
        request.resource.data.target is string && request.resource.data.body is string &&
        request.resource.data.body.size() <= 2000 && request.resource.data.count is int && request.resource.data.count > 0;
    }
  }
}
