rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  function isAdmin() {
    return request.auth != null
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
  }

    match /users/{userId} {

      // Users can read their own profile
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      // Users can create their own entrant or campsite owner profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ["entrant", "owner"]
                    && request.resource.data.keys().hasAll(
                      ["uid", "name", "email", "role", "username", "phoneNumber"]
                    )
                    && request.resource.data.keys().hasOnly(
                      ["uid", "name", "email", "role", "username", "phoneNumber"]
                    )
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.username is string
                    && request.resource.data.phoneNumber is string;

      // Prevent changes to profiles for now
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /campsites/{campsiteId}{
    
    allow read: if request.auth != null;

    allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

    allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

    
    }
    // Entrants can read their own reservations
    match /Reservations/{reservationId} {
    allow read: if request.auth != null
    && resource.data.entrantId == request.auth.uid;
    }

    // Additional access for lotteries, reservations and messaging
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function staff() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function ownsSite(id) { return self(get(/databases/$(database)/documents/campsites/$(id)).data.ownerId); }
    function matchesLink(value, collection, id, key) {
      return value == id || value == /databases/$(database)/documents/$(collection)/$(id)
        || (value is map && value.get(key, '') == id);
    }

    match /Lotteries/{id} {
      allow read: if signedIn();
      allow write: if staff();
      // Compare one membership change, for either joining or leaving.
      function addsSelf(shorter, longer) {
        let added = longer.removeAll(shorter);
        return added.size() == 1 && longer.size() == shorter.size() + 1
          && longer.removeAll(added) == shorter && matchesLink(added[0], 'users', request.auth.uid, 'uid');
      }
      function ownWaitlistChange() {
        let old = resource.data.get('entrants', []);
        let before = old == null ? [] : old;
        let after = request.resource.data.entrants;
        return before == after || addsSelf(before, after) || addsSelf(after, before);
      }
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entrants'])
        && ownWaitlistChange();
    }
    match /Reservations/{id} {
      allow read: if staff() || ownsSite(resource.data.campsiteId);
      allow create: if self(request.resource.data.entrantId);
      allow update: if (self(resource.data.entrantId) || staff() || ownsSite(resource.data.campsiteId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /CampsiteBookingLocks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.bookedDates is map;
    }

    // Older Android builds still save this selection before sending.
    match /users/{uid}/messagingContext/campsite {
      allow get, create, update: if self(uid);
    }
    match /messages/{id} {
      // A waitlist notice belongs to the selected campsite and an actual waitlisted user.
      function waitlistNotice(d) {
        let draw = get(/databases/$(database)/documents/Lotteries/$(d.lotteryId)).data;
        return d.kind == 'waitlist_notice' && ownsSite(d.campsiteId)
          && matchesLink(draw.campsites[d.siteIndex], 'campsites', d.campsiteId, 'id')
          && matchesLink(draw.entrants[d.entrantIndex], 'users', d.receiverId, 'uid');
      }
      function reservationMail(d) {
        let booking = get(/databases/$(database)/documents/Reservations/$(d.reservationId)).data;
        let entrant = booking.entrantId;
        let site = booking.campsiteId;
        let owner = get(/databases/$(database)/documents/campsites/$(site)).data.ownerId;
        return (d.senderId == owner && d.receiverId == entrant)
            || (d.senderId == entrant && d.receiverId == owner);
      }
      allow read: if self(resource.data.get('senderId', '')) || self(resource.data.get('receiverId', '')) || isAdmin();
      allow create: if self(request.resource.data.senderId) && request.resource.data.message is string
        && ((request.resource.data.type == 'direct' && reservationMail(request.resource.data))
          || (request.resource.data.type == 'notification' && waitlistNotice(request.resource.data)));
    }
    match /users/{uid}/messageRequests/{requestId} {
      allow get, create: if self(uid);
    }
  }
}
